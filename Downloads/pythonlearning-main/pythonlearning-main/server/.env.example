# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Database Connection
# Format: postgres://username:password@localhost:5432/database_name
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/python_adaptive_db
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/python_adaptive_test_db

# Security & Sessions
SESSION_SECRET=super_secret_session_key_change_in_production_min_32_chars_long
SESSION_EXPIRY_DAYS=14
COOKIE_SECURE=false

# Client Configuration for CORS
FRONTEND_URL=http://localhost:5174
